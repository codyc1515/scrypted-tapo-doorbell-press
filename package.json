    "interfaces": [
      "MixinProvider"
    ],
    "rollup": true
  },
  "dependencies": {
    "@scrypted/sdk": "^0.5.59"
  },
  "devDependencies": {
    "@types/node": "^24.0.10"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "tapo",
    "doorbell",
    "homekit"
  ],
  "license": "MIT",
  "files": [
    "dist/plugin.zip",
    "README.md"
  ]
