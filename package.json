{
  "name": "scrypted-tapo-doorbell-press",
  "version": "0.2.0",
  "description": "Local UDP doorbell press detection for TP-Link Tapo cameras in Scrypted",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codyc1515/scrypted-tapo-doorbell-press.git"
  },
  "scripts": {
    "build": "scrypted-webpack",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-deploy-debug": "scrypted-deploy-debug",
    "prepublishOnly": "NODE_ENV=production scrypted-webpack"
  },
  "scrypted": {
    "name": "Tapo Doorbell Press",
    "type": "API",
    "interfaces": [
      "MixinProvider"
    ],
    "rollup": true
  },
  "devDependencies": {
    "@scrypted/sdk": "^0.5.59",
    "@types/node": "^26.6.6"
  },
  "overrides": {
    "@scrypted/sdk": {
      "@rollup/plugin-terser": "^1.0.2",
      "adm-zip": "^0.6.1"
    }
  },
  "keywords": [
    "scrypted",
    "plugin",
    "tapo",
    "doorbell",
    "homekit"
  ],
  "license": "MIT",
  "files": [
    "dist/plugin.zip",
    "README.md"
  ]
}
